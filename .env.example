# =======================================================
# CODESOFT FÚTBOL - VARIABLES DE ENTORNO DE EJEMPLO
# =======================================================

# NVIDIA NIM API (Llama 3.1 70B Instruct / GPU Cloud)
# Obtén tu key gratis en: https://build.nvidia.com
NVIDIA_API_KEY=tu_clave_de_nvidia_aqui

# Modelo de chat a usar (opcional). Ver los disponibles en https://build.nvidia.com/models
# NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b

# Señal por defecto del reproductor "Mi señal" (opcional): .m3u8, .mp4, YouTube o Twitch
# Ejemplo: stream HLS público de prueba de Mux
SIGNAL_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# RapidAPI (Football Live Stream API), para "Ver en vivo". Solo la usa el proxy del servidor.
# En Netlify: Site settings → Environment variables.
RAPIDAPI_KEY=tu_clave_de_rapidapi_aqui
